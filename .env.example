# Copy to .env to override the defaults used by docker-compose.yml.

# MySQL root password (service accounts are defined in mysql/init/).
MYSQL_ROOT_PASSWORD=root
# Host port for MySQL; 3307 avoids clashing with a local MySQL server.
MYSQL_HOST_PORT=3307

# Replay speed for make replay, in lines per second, and total lines (0 = everything).
# Both months together are about 3.4 million lines: ~2 hours at 500 lines/s.
REPLAY_RATE=500
REPLAY_LIMIT=0

# Host port for the web dashboard.
DASHBOARD_HOST_PORT=3030
